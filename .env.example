# ==========================================
# Kisan Saathi (किसान साथी) Environment Configuration
# ==========================================

# Data & Government APIs
DATA_GOV_API_KEY=your_datagov_key_here
DATA_GOV_RESOURCE_ID=
DATA_MODE=auto # "auto", "sample", or "synthetic"
DUCKDB_PATH=data/kisan.duckdb

# Routing & Weather
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OSRM_BASE_URL=https://router.project-osrm.org
USE_LIVE_OSRM=false

# LLM Providers (Gemini / Groq / Fallback)
LLM_PROVIDER=gemini # "gemini", "groq", or "rule_based"
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_FALLBACK_PROVIDER=rule_based
LLM_TIMEOUT_SECONDS=15

# Indic Voice & Audio (Sarvam AI / Bhashini)
SARVAM_API_KEY=your_sarvam_api_key_here
BHASHINI_API_KEY=
BHASHINI_USER_ID=

# Server Configuration
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_CHAT_PER_MIN=20
LOG_LEVEL=INFO
